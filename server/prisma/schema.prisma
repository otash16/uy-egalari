generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Operator (call-centerda ishlovchi odam). Har bir karta va qo'ng'iroq operatorga bog'lanadi.
model Operator {
  name       String    @id
  color      Int       @default(0)
  /// "linphone" | "microsip" | "" — agent qaysi dasturdan o'qiyapti
  softphone  String    @default("")
  /// Agentdan oxirgi xabar kelgan vaqt (ulanganini ko'rsatish uchun)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Kanban ustuni (bosqich): "Yangi", "Qo'ng'iroq qilindi" va h.k.
model Column {
  id        String   @id @default(cuid())
  name      String
  color     Int      @default(0)
  order     Float
  leads     Lead[]
  createdAt DateTime @default(now())
}

/// Uy egasi (lid) — bitta kanban kartasi.
model Lead {
  id         String   @id @default(cuid())
  ownerName  String   @default("")
  phone      String   @default("")
  /// Qidiruv va dublikat tekshiruvi uchun: faqat raqamlar, 998 prefiksisiz.
  phoneKey   String   @default("")
  houseName  String   @default("")
  olxUrl     String   @default("")
  rentmeUrl  String   @default("")
  note       String   @default("")
  /// Qayta qo'ng'iroq sanasi, YYYY-MM-DD yoki bo'sh.
  nextCall   String   @default("")
  /// Qo'lda tanlangan natija: "" | no_answer | talked | declined
  callResult String   @default("")
  /// Mas'ul operator (Operator.name). Kim birinchi qo'shgan bo'lsa — o'sha. Bo'sh = belgilanmagan.
  operator   String   @default("")
  /// Softphone'dagi kontakt id (masalan Linphone friend.id), import orqali kelgan bo'lsa.
  extId      String   @default("")
  order      Float
  columnId   String
  column     Column   @relation(fields: [columnId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([columnId, order])
  @@index([phoneKey])
}

/// Softphone'dan bir marta olingan kontaktlar — o'chirilgan karta qayta qo'shilmasligi uchun.
model ContactImport {
  operator   String
  extId      String
  importedAt DateTime @default(now())

  @@id([operator, extId])
}

/// Operator softphone'idan olingan qo'ng'iroq. Kartaga telefon raqami (phoneKey) orqali bog'lanadi.
model Call {
  id          String    @id @default(cuid())
  /// Kimning softphone'idan (Operator.name)
  operator    String    @default("")
  /// Softphone'dagi id (Linphone conference_call.id, MicroSIP call_log.id)
  extId       String
  /// "out" — chiquvchi, "in" — kiruvchi
  direction   String
  /// success | aborted | missed | declined | early_aborted | accepted_elsewhere | declined_elsewhere | unknown
  status      String
  /// Qarshi tomon raqami (SIP manzilning user qismi)
  number      String
  phoneKey    String
  startedAt   DateTime
  connectedAt DateTime?
  /// Gaplashilgan vaqt, soniyada
  duration    Int       @default(0)

  @@unique([operator, extId])
  @@index([phoneKey])
  @@index([startedAt])
}

/// Doskaga kiruvchi odam: login/parol va rol. Operator rolidagi foydalanuvchi Operator yozuviga bog'lanadi.
model User {
  id           String    @id @default(cuid())
  login        String    @unique
  /// Ko'rsatiladigan ism
  name         String
  /// scrypt$salt$hash
  passwordHash String
  /// Dasturchi: hammasi + foydalanuvchilarni boshqarish
  isAdmin      Boolean   @default(false)
  /// Kanban doskasiga kirish
  canBoard     Boolean   @default(true)
  /// Boshliqlar dashboardiga kirish
  canDashboard Boolean   @default(false)
  /// Bog'langan Operator.name — kartalar va qo'ng'iroqlar shu nomga yoziladi. Bo'sh = yo'q (masalan PM).
  operator     String    @default("")
  /// Softphone agenti uchun Bearer token (faqat operator bog'langan bo'lsa ishlaydi)
  agentToken   String?   @unique
  active       Boolean   @default(true)
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Brauzer sessiyasi (cookie uy_sid = id).
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
