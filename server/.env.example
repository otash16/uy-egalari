# Baza fayli (nisbiy yo'l prisma/ papkasidan hisoblanadi)
DATABASE_URL="file:./dev.db"
# Sayt ochiq internetda bo'lsa — umumiy kirish paroli (bo'sh = himoyasiz, faqat ofis tarmog'i uchun)
BOARD_PASSWORD=

# Instagram lidlari tushadigan Google Sheets (havola bilan ochiq bo'lishi shart). Bo'sh = Mirobod formasi.
INSTAGRAM_SHEET_ID=

# Asterisk (PBX) qo'ng'iroq jurnali — server PBX bilan bitta mashinada bo'lsa. Bo'sh = o'chirilgan, agentlar ishlatiladi.
ASTERISK_CDR=
# Ichki raqam → operator: "101:Otajon,102:Akbar"
ASTERISK_EXTENSIONS=
# Shu sanadan oldingi qatorlar o'qilmaydi (agentlar davridagi tarix takrorlanmasin)
ASTERISK_SINCE=2026-10-28T00:00:00Z
