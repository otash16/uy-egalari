generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

/// Kanban ustuni (bosqich): "Yangi", "Qo'ng'iroq qilindi" va h.k.
model Column {
  id        String   @id @default(cuid())
  name      String
  color     Int      @default(0)
  order     Float
  leads     Lead[]
  createdAt DateTime @default(now())
}

/// Uy egasi (lid) — bitta kanban kartasi.
model Lead {
  id         String   @id @default(cuid())
  ownerName  String   @default("")
  phone      String   @default("")
  /// Qidiruv va dublikat tekshiruvi uchun: faqat raqamlar, 998 prefiksisiz.
  phoneKey   String   @default("")
  houseName  String   @default("")
  olxUrl     String   @default("")
  rentmeUrl  String   @default("")
  note       String   @default("")
  /// Qayta qo'ng'iroq sanasi, YYYY-MM-DD yoki bo'sh.
  nextCall   String   @default("")
  /// Qo'lda tanlangan natija: "" | no_answer | talked | declined
  callResult String   @default("")
  order      Float
  columnId   String
  column     Column   @relation(fields: [columnId], references: [id], onDelete: Restrict)
  linphoneId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([columnId, order])
  @@index([phoneKey])
}

/// Linphone'dan bir marta olingan kontaktlar — o'chirilgan karta qayta qo'shilmasligi uchun.
model LinphoneImport {
  linphoneId Int      @id
  importedAt DateTime @default(now())
}

/// Linphone qo'ng'iroqlar tarixidan olingan qo'ng'iroq. Kartaga telefon raqami (phoneKey) orqali bog'lanadi.
model Call {
  /// Linphone'dagi conference_call.id
  id          Int       @id
  /// "out" — chiquvchi, "in" — kiruvchi
  direction   String
  /// success | aborted | missed | declined | early_aborted | accepted_elsewhere | declined_elsewhere
  status      String
  /// Qarshi tomon raqami (SIP manzilning user qismi)
  number      String
  phoneKey    String
  startedAt   DateTime
  connectedAt DateTime?
  /// Gaplashilgan vaqt, soniyada
  duration    Int       @default(0)

  @@index([phoneKey])
  @@index([startedAt])
}
